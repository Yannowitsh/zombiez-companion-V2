{
  "schemaVersion": 1,
  "id": "zombiezcompanionv2",
  "version": "${version}",
  "name": "ZombieZ Companion V2",
  "description": "Client-side, read-only QoL companion mod for the ZombieZ Minecraft server. Provides modular overlays and helpers; never automates gameplay.",
  "authors": ["yannowitsh, KEOZ5"],
  "contact": {
    "homepage": "https://github.com/Yannowitsh/zombiez-companion-V2",
    "sources":  "https://github.com/Yannowitsh/zombiez-companion-V2",
    "issues":   "https://github.com/Yannowitsh/zombiez-companion-V2/issues"
  },
  "license": "MIT",
  "icon": "assets/zombiezcompanion/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.keoz5.zombiezcompanion.ZombieZCompanionClient"
    ],
    "modmenu": [
      "io.github.keoz5.zombiezcompanion.ui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "zombiezcompanion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api":   "*",
    "minecraft":    "${mc_dep}",
    "java":         ">=${java_dep}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
