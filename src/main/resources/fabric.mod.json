{
  "schemaVersion": 1,
  "id": "zombiezcompanion",
  "version": "${version}",
  "name": "ZombieZ Companion",
  "description": "Client-side, read-only QoL companion mod for the ZombieZ Minecraft server. Provides modular overlays and helpers; never automates gameplay.",
  "authors": ["KEOZ5"],
  "contact": {
    "homepage": "https://github.com/KEOZ5/zombiez-companion",
    "sources":  "https://github.com/KEOZ5/zombiez-companion",
    "issues":   "https://github.com/KEOZ5/zombiez-companion/issues"
  },
  "license": "MIT",
  "icon": "assets/zombiezcompanion/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.keoz5.zombiezcompanion.ZombieZCompanionClient"
    ],
    "modmenu": [
      "io.github.keoz5.zombiezcompanion.ui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "zombiezcompanion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "fabric-api":   "*",
    "minecraft":    "~1.21.4",
    "java":         ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
